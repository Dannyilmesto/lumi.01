# API llama.cpp OpenAI-compatible. Bind llama-server to loopback, never 0.0.0.0.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=SoAIHQ/Qwen3.5-9B-GGUF:Q4_K_M
# llama.cpp does not require a real key; this placeholder is sent as a bearer token.
LLM_API_KEY=local
LLM_CONTEXT_SIZE=8192
LLM_ENABLE_THINKING=false

# Email account connections (Google Gmail API + Microsoft Graph).
# Register each callback URL as a Web redirect URI in the provider console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Use "common" for organizational and personal Microsoft accounts, or a tenant ID.
MICROSOFT_OAUTH_TENANT_ID=common
# Optional: 32 random bytes encoded as Base64. Otherwise derived from BETTER_AUTH_SECRET.
EMAIL_TOKEN_ENCRYPTION_KEY=
