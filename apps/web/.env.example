# PostgreSQL (docker-compose.yml). Local development credentials only.
DATABASE_URL=postgresql://serramenti:serramenti_dev@127.0.0.1:5432/serramenti

# Better Auth. Generate the secret with `pnpm dlx auth@latest secret` and keep it stable:
# it also derives the email encryption key when EMAIL_TOKEN_ENCRYPTION_KEY is empty.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# SMTP for verification and password reset emails (Mailpit in development: http://localhost:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Lumi <noreply@localhost>

# Optional: file storage (relative to apps/web). Only the "local" provider is available.
# OBJECT_STORAGE_PROVIDER=local
# UPLOADS_DIR=.data/uploads
# PROFILE_ARCHIVE_DIR=.data/profile-archive

# Optional: Python interpreter of the document worker.
# Default: services/document-worker/.venv (bin/python or Scripts\python.exe).
# SERRAMENTI_DOCUMENT_WORKER_PYTHON=

# Optional: set to false to disable assistant web tools (news, weather, SearXNG search).
# WEB_ACCESS_ENABLED=true

# API llama.cpp OpenAI-compatible. Bind llama-server to loopback, never 0.0.0.0.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=SoAIHQ/Qwen3.5-9B-GGUF:Q4_K_M
# llama.cpp does not require a real key; this placeholder is sent as a bearer token.
LLM_API_KEY=local
LLM_CONTEXT_SIZE=8192
LLM_ENABLE_THINKING=false

# Email account connections (Google Gmail API + Microsoft Graph).
# Register each callback URL as a Web redirect URI in the provider console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Use "common" for organizational and personal Microsoft accounts, or a tenant ID.
MICROSOFT_OAUTH_TENANT_ID=common
# Optional: 32 random bytes encoded as Base64. Otherwise derived from BETTER_AUTH_SECRET.
EMAIL_TOKEN_ENCRYPTION_KEY=
